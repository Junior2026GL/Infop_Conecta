PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=infop_conecta

JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=8h

META_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Plantilla de categoría "Authentication" aprobada en Meta WhatsApp Manager,
# usada para enviar el código de recuperación de contraseña.
WHATSAPP_OTP_TEMPLATE_NAME=recuperacion_contrasena
WHATSAPP_OTP_TEMPLATE_LANG=es
# none | copy_code | url — según el botón configurado en la plantilla
WHATSAPP_OTP_BUTTON_TYPE=copy_code
